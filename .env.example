# JWT Authentication Secret (generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# Database Configuration (PostgreSQL URL format for Supabase/Vercel)
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]?sslmode=require
DATABASE_URL=postgresql://postgres:your_password_here@db.your-supabase-project.supabase.co:5432/postgres?sslmode=require

# Mistral AI - OCR Integration (https://console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_OCR_MODEL=pixtral-12b-latest

# Google Gemini - Diet Plan & AI Features (https://console.cloud.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: For production monitoring
NODE_ENV=production


